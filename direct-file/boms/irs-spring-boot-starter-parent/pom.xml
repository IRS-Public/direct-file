<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0-RC1</version>
        <relativePath/>
        <!-- lookup parent from repository -->
    </parent>
    <groupId>gov.irs.directfile.boot</groupId>
    <artifactId>irs-spring-boot-starter-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>IRS Spring Boot Starter Parent</name>
    <description>IRS Spring Boot starter parent pom.xml</description>
    <properties>
        <!-- maven properties-->
        <java.version>25</java.version>

        <!-- Spring Boot 3.4.x ships Mockito 5.14.2 / ByteBuddy 1.15.11, which cannot
             instrument mocks on JDK 25. Bump to a coherent JDK-25-capable pair
             (Mockito 5.23.0 is built against ByteBuddy 1.17.7). The byte-buddy.version
             property also drives byte-buddy-agent. -->
        <mockito.version>5.23.0</mockito.version>
        <byte-buddy.version>1.17.7</byte-buddy.version>

        <!-- dependency management versions-->
        <amazon-sqs-java-messaging-lib.version>2.1.4</amazon-sqs-java-messaging-lib.version>
        <aws-encryption-sdk.version>3.0.2</aws-encryption-sdk.version>
        <!-- https://docs.aws.amazon.com/encryption-sdk/latest/developer-guide/java.html#java-installation -->
        <aws-sdk.version>2.30.19</aws-sdk.version>
        <!-- https://docs.aws.amazon.com/sdk-for-java/latest/developer-guide/setup-project-maven.html#sdk-as-dependency -->
        <jaxb-api.version>2.3.1</jaxb-api.version>
        <!-- Spring Boot 4 removed dependency management for Testcontainers, so its BOM is
             imported explicitly below. Pinned to the 1.x line because Testcontainers 2.0
             dropped the standalone org.testcontainers:junit-jupiter artifact that state-api
             references. -->
        <testcontainers.version>1.21.3</testcontainers.version>
        <!-- Spring AI 2.0.x is the Spring Boot 4 / Spring Framework 7-aligned line and carries
             the MCP Streamable HTTP transport (protocol=STREAMABLE) that tax-advisor's MCP
             server uses. 2.0.0 is currently a milestone (M8). -->
        <spring-ai.version>2.0.0-M8</spring-ai.version>
        <logstash.version>9.0</logstash.version>
        <modelmapper.version>3.2.6</modelmapper.version>
        <modelmapper-module-record.version>1.0.0</modelmapper-module-record.version>
        <spotbugs.version>4.9.8</spotbugs.version>
        <!-- springdoc 3.x is the Spring Boot 4 / Spring Framework 7 compatible line
             (2.x targets Boot 3). -->
        <springdoc.version>3.0.3</springdoc.version>

        <pdfbox.version>3.0.7</pdfbox.version>
        <amazon-s3-encryption-client-java.version>3.1.3</amazon-s3-encryption-client-java.version>
        <aws.java.sdk.version>2.20.131</aws.java.sdk.version>
        <bouncycastle.bcpkix.version>1.84</bouncycastle.bcpkix.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <commons-io.version>2.22.0</commons-io.version>
        <commons-text.version>1.15.0</commons-text.version>
        <guava-version>33.6.0-jre</guava-version>
        <wiremock.version>3.13.2</wiremock.version>
        <openfeature.version>1.20.2</openfeature.version>
        <!-- Boot 3.3 transitively managed okhttp3; Boot 3.4 removed that
             management entry, so state-api needs an explicit pin here. -->
        <okhttp3.version>5.3.2</okhttp3.version>

        <!-- maven plugin versions-->
        <cyclonedx-maven-plugin.version>2.9.1</cyclonedx-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.14</jacoco-maven-plugin.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <!-- maven-pmd-plugin 3.28.0 bundles PMD 7.17.0, whose ASM can't parse JDK 26 class
             files (StackOverflowError in ParseLock#doParse). PMD 7.21.0 added Java 26 support
             (pmd/pmd#5871); override the plugin's PMD modules to that version. -->
        <pmd.version>7.21.0</pmd.version>
        <maven-site-plugin.version>3.12.1</maven-site-plugin.version>
        <spotbugs-maven-plugin.version>4.9.8.3</spotbugs-maven-plugin.version>
        <!-- Spotless/Palantir 2.43.0/2.39.0 use javac internals that changed in JDK 25
             (NoSuchMethodError in Log$DeferredDiagnosticHandler). Bumped to JDK-25-capable releases. -->
        <spotless-maven-plugin.version>3.6.0</spotless-maven-plugin.version>
        <jaxb2-maven-plugin.version>3.2.0</jaxb2-maven-plugin.version>
        <maven-project-info-reports-plugin.version>3.5.0</maven-project-info-reports-plugin.version>

        <config-folder.path>${project.basedir}/../../config</config-folder.path>

        <!-- Spotless properties-->
        <spotless-plugin.palantirVersion>2.91.0</spotless-plugin.palantirVersion>
        <spotless-plugin.file.xml-prefs>${config-folder.path}/spotless-xml.prefs</spotless-plugin.file.xml-prefs>

        <!-- SpotBugs properties-->
        <findsecbugs-plugin.version>1.12.0</findsecbugs-plugin.version>
        <spotbugs-maven-plugin.includeFilterFile>${config-folder.path}/spotbugs-include.xml</spotbugs-maven-plugin.includeFilterFile>
        <spotbugs-maven-plugin.excludeFilterFile>${config-folder.path}/spotbugs-exclude.xml</spotbugs-maven-plugin.excludeFilterFile>

        <!-- PMD properties -->
        <maven-pmd-plugin.ruleset>${config-folder.path}/pmd-static-analysis-ruleset.xml</maven-pmd-plugin.ruleset>

        <!-- Sonar properties-->
        <sonar.java.coveragePlugin>jacoco</sonar.java.coveragePlugin>
        <sonar.coverage.jacoco.xmlReportPaths>${project.basedir}/target/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.dynamicAnalysis>reuseReports</sonar.dynamicAnalysis>
        <sonar.language>java</sonar.language>

        <!-- IRS-internal artifact versions (built locally / via the standalone fact-graph repo) -->
        <starter-boilerplate.version>0.0.1-SNAPSHOT</starter-boilerplate.version>
        <starter-validation.version>0.0.1-SNAPSHOT</starter-validation.version>
        <starter-test.version>0.0.1-SNAPSHOT</starter-test.version>
        <starter-openfeature.version>0.0.1-SNAPSHOT</starter-openfeature.version>
        <data-models.version>0.0.1-SNAPSHOT</data-models.version>
        <fact-graph.version>3.1.0-SNAPSHOT</fact-graph.version>
        <loaders.version>0.0.1-SNAPSHOT</loaders.version>
        <xmlsec.version>4.0.2</xmlsec.version>
    </properties>
    <dependencyManagement>
        <dependencies>
            <!-- pom imports -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- dependencies not managed by a BOM -->
            <dependency>
                <groupId>com.amazonaws</groupId>
                <artifactId>aws-encryption-sdk-java</artifactId>
                <version>${aws-encryption-sdk.version}</version>
            </dependency>
            <dependency>
                <groupId>com.amazonaws</groupId>
                <artifactId>amazon-sqs-java-messaging-lib</artifactId>
                <version>${amazon-sqs-java-messaging-lib.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-annotations</artifactId>
                <version>${spotbugs.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash.version}</version>
            </dependency>
            <dependency>
                <groupId>javax.xml.bind</groupId>
                <artifactId>jaxb-api</artifactId>
                <version>${jaxb-api.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.encryption.s3</groupId>
                <artifactId>amazon-s3-encryption-client-java</artifactId>
                <version>${amazon-s3-encryption-client-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>${commons-compress.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava-version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcpkix-jdk18on</artifactId>
                <version>${bouncycastle.bcpkix.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.modelmapper</groupId>
                <artifactId>modelmapper</artifactId>
                <version>${modelmapper.version}</version>
            </dependency>
            <!-- https://mvnrepository.com/artifact/org.modelmapper/modelmapper-module-record -->
            <dependency>
                <groupId>org.modelmapper</groupId>
                <artifactId>modelmapper-module-record</artifactId>
                <version>${modelmapper-module-record.version}</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-jetty12</artifactId>
                <version>${wiremock.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${commons-text.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.openfeature</groupId>
                <artifactId>sdk</artifactId>
                <version>${openfeature.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp3.version}</version>
            </dependency>
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>mockwebserver</artifactId>
                <version>${okhttp3.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs.boot</groupId>
                <artifactId>irs-spring-boot-starter-openfeature</artifactId>
                <version>${starter-openfeature.version}</version>
            </dependency>

            <!--
        	    Security pins.

        	    Packages that are pinned to specific versions for vulnerability mitigation are included here.
        	-->
            <dependency>
                <groupId>org.xmlunit</groupId>
                <artifactId>xmlunit-core</artifactId>
                <version>2.12.0</version>
            </dependency>
            <dependency>
                <groupId>com.sun.xml.ws</groupId>
                <artifactId>jaxws-rt</artifactId>
                <version>4.0.4</version>
            </dependency>
            <dependency>
                <groupId>io.lettuce</groupId>
                <artifactId>lettuce-core</artifactId>
                <version>7.6.0.RELEASE</version>
            </dependency>
            <!-- end of security pins -->

            <!-- IRS and DirectFile packages (built locally; see ONBOARDING.md) -->
            <dependency>
                <groupId>gov.irs.boot</groupId>
                <artifactId>irs-spring-boot-starter-boilerplate</artifactId>
                <version>${starter-boilerplate.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs.boot</groupId>
                <artifactId>irs-spring-boot-starter-validation</artifactId>
                <version>${starter-validation.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs.boot</groupId>
                <artifactId>irs-spring-boot-starter-test</artifactId>
                <version>${starter-test.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs.directfile</groupId>
                <artifactId>data-models</artifactId>
                <version>${data-models.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs</groupId>
                <artifactId>factgraph_3</artifactId>
                <version>${fact-graph.version}</version>
            </dependency>
            <dependency>
                <groupId>gov.irs.directfile</groupId>
                <artifactId>loaders</artifactId>
                <version>${loaders.version}</version>
            </dependency>

            <dependency>
                <groupId>gov.irs</groupId>
                <artifactId>xmlsec</artifactId>
                <version>${xmlsec.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <!-- default dependencies-->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.46</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.46</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>${maven-site-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.github.spotbugs</groupId>
                    <artifactId>spotbugs-maven-plugin</artifactId>
                    <version>${spotbugs-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>${spotless-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>jaxb2-maven-plugin</artifactId>
                    <version>${jaxb2-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>${maven-project-info-reports-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <configuration>
                    <propertyFile>.liquibase.properties</propertyFile>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <configuration>
                    <formats>
                        <format>
                            <includes>
                                <include>src/**/*.xml</include>
                            </includes>
                            <excludes>
                                <exclude>**/spotbugs/output/spotbugs.xml</exclude>
                                <exclude>src/main/resources/pmd/static-analysis-ruleset.xml</exclude>
                                <exclude>target/pmd/rulesets/*.xml</exclude>
                                <exclude>src/test/resources/scenarios/xml-snapshots/*.xml</exclude>
                                <exclude>src/test/resources/scenarios-ero/xml-snapshots/*.xml</exclude>
                            </excludes>
                            <eclipseWtp>
                                <type>XML</type>
                                <files>
                                    <file>${spotless-plugin.file.xml-prefs}</file>
                                </files>
                            </eclipseWtp>
                            <trimTrailingWhitespace/>
                        </format>
                        <format>
                            <includes>
                                <include>**/.gitignore</include>
                                <include>**/.dockerignore</include>
                                <include>**/*.yml</include>
                                <include>**/*.yaml</include>
                            </includes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                    <json>
                        <includes>
                            <!-- ideally, we can change this to cover all json files -->
                            <!-- <include>**/*.json</include> -->

                            <!-- for now, only format the scenario files (in the backend project) -->
                            <include>src/test/resources/scenarios/*.json</include>
                            <include>src/test/resources/scenarios-ero/*.json</include>
                        </includes>
                        <gson>
                            <sortByKeys>true</sortByKeys>
                            <indentSpaces>2</indentSpaces>
                        </gson>
                    </json>
                    <pom>
                        <includes>
                            <include>pom.xml</include>
                        </includes>
                        <sortPom>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <expandEmptyElements>false</expandEmptyElements>
                        </sortPom>
                    </pom>
                    <java>
                        <palantirJavaFormat>
                            <version>${spotless-plugin.palantirVersion}</version>
                        </palantirJavaFormat>
                        <importOrder>
                            <order>java,,gov.irs,gov.irs.factgraph,gov.irs.directfile,\#</order>
                        </importOrder>
                        <excludes>
                            <exclude>src/main/java/gov/irs/directfile/api/xmlgeneration/xml/**</exclude>
                        </excludes>
                        <removeUnusedImports/>
                        <formatAnnotations/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.5</schemaVersion>
                    <includeLicenseText>false</includeLicenseText>
                    <outputName>bom</outputName>
                    <outputDirectory>target</outputDirectory>
                    <skipNotDeployed>false</skipNotDeployed>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-initialize</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-site</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <phase>package</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <!--Bug Descriptions can be found here: https://spotbugs.readthedocs.io/en/stable/bugDescriptions.html -->
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <!-- For information on configuration properties:  -->
                <configuration>
                    <includeFilterFile>${spotbugs-maven-plugin.includeFilterFile}</includeFilterFile>
                    <excludeFilterFile>${spotbugs-maven-plugin.excludeFilterFile}</excludeFilterFile>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <xmlOutput>true</xmlOutput>

                    <xmlOutputDirectory>spotbugs/output</xmlOutputDirectory>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <!-- Configuration Parameters: https://maven.apache.org/plugins/maven-pmd-plugin/check-mojo.html -->
                <configuration>
                    <failOnViolation>true</failOnViolation>
                    <printFailingErrors>true</printFailingErrors>
                    <rulesets>
                        <ruleset>${maven-pmd-plugin.ruleset}</ruleset>
                    </rulesets>
                </configuration>
                <!-- Override the PMD version bundled with the plugin so analysis works on JDK 26
                     (see pmd.version above). All four modules the plugin pulls are pinned together
                     to keep PMD's internals on a single version. -->
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-javascript</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-jsp</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>compile</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <reporting>
        <plugins>
            <plugin>
                <!--Bug Descriptions can be found here: https://spotbugs.readthedocs.io/en/stable/bugDescriptions.html -->
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <effort>Max</effort>
                    <threshold>Medium</threshold>
                    <xmlOutput>true</xmlOutput>

                    <xmlOutputDirectory>spotbugs/output</xmlOutputDirectory>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>
            <plugin>
                <!-- https://maven.apache.org/plugins/maven-pmd-plugin/  -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <rulesets>
                        <ruleset>${maven-pmd-plugin.ruleset}</ruleset>
                    </rulesets>
                </configuration>
                <reportSets>
                    <reportSet>
                        <reports>
                            <report>pmd</report>
                        </reports>
                    </reportSet>
                </reportSets>
            </plugin>
        </plugins>
    </reporting>
</project>
